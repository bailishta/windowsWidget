<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Padding="32" RowSpacing="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid ColumnSpacing="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Spacing="6"><TextBlock x:Name="Heading" Text="桌面小组件" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Text="让常用信息，留在桌面。" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <ComboBox x:Name="LanguagePicker" Width="112" AutomationProperties.Name="Language / 语言"><ComboBoxItem Content="中文"/><ComboBoxItem Content="English"/></ComboBox>
      <ComboBox x:Name="ThemePicker" Width="142" SelectedIndex="0" AutomationProperties.Name="外观主题"><ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/></ComboBox>
    </StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="PluginPicker" HorizontalAlignment="Stretch" PlaceholderText="正在发现小组件…" AutomationProperties.Name="小组件插件"/>
      <Button x:Name="AddButton" Grid.Column="1" Content="添加到桌面" Style="{StaticResource AccentButtonStyle}"/>
      <Button x:Name="RefreshButton" Grid.Column="2" Content="重新扫描"/>
      <Button x:Name="FolderButton" Grid.Column="3" Content="插件目录"/>
    </Grid>
  </Border>
  <Grid Grid.Row="2" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
    <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="CountLabel" Text="运行实例" FontSize="18" FontWeight="SemiBold"/><ListView x:Name="InstanceList" Grid.Row="1" SelectionMode="Single" HorizontalContentAlignment="Stretch" AutomationProperties.Name="运行实例列表"/></Grid>
    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
      <ScrollViewer x:Name="DetailScroll"><StackPanel Spacing="14"><TextBlock x:Name="SettingsHeading" Text="组件设置" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="DetailLabel" Text="添加或选择一个小组件。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="EnableButton" Content="启用"/><Button x:Name="RetryButton" Content="重试"/><Button x:Name="RemoveButton" Content="移除"/></StackPanel>
        <ToggleSwitch x:Name="LockSwitch" Header="布局锁定" OffContent="可拖动与调整尺寸" OnContent="固定位置和尺寸"/>
        <TextBlock x:Name="SizeHeading" Text="大小（桌面图标格）"/>
        <ComboBox x:Name="SizePreset" HorizontalAlignment="Stretch" PlaceholderText="常用大小">
          <ComboBoxItem Content="1 × 1" Tag="1,1"/><ComboBoxItem Content="1 × 2" Tag="1,2"/>
          <ComboBoxItem Content="2 × 1" Tag="2,1"/><ComboBoxItem Content="2 × 2" Tag="2,2"/>
          <ComboBoxItem Content="3 × 2" Tag="3,2"/><ComboBoxItem Content="3 × 3" Tag="3,3"/>
          <ComboBoxItem Content="4 × 2" Tag="4,2"/>
        </ComboBox>
        <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <NumberBox x:Name="ColumnsBox" Header="宽（格）" Minimum="1" Maximum="12" Value="3" SmallChange="1" SpinButtonPlacementMode="Compact"/>
          <NumberBox x:Name="RowsBox" Grid.Column="1" Header="高（格）" Minimum="1" Maximum="12" Value="2" SmallChange="1" SpinButtonPlacementMode="Compact"/>
        </Grid>
        <Button x:Name="ApplySizeButton" Content="应用大小"/>
        <TextBlock x:Name="SizeHint" Text="1 格包含一个桌面图标及其周围留白。" TextWrapping="Wrap" FontSize="12"/>
        <TextBlock x:Name="ConfigHeading" Text="插件配置（JSON）"/><TextBox x:Name="ConfigEditor" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" FontFamily="Consolas" AutomationProperties.Name="插件配置 JSON"/>
        <Button x:Name="SaveConfigButton" Content="应用配置"/>
        <TextBlock x:Name="ErrorLabel" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
        <TextBlock x:Name="TrayHint" Text="关闭此窗口后，小组件仍在运行。&#xA;可从系统托盘重新打开或退出。" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
      </StackPanel></ScrollViewer>
    </Border>
  </Grid>
  <Grid Grid.Row="3" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="Footer" Text="原型 · 独立进程托管 · 自动保存布局" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <Button x:Name="LogsButton" Grid.Column="1" Content="打开日志"/>
  </Grid>
</Grid>

