  <Reference Include="$(RepoRoot)packages\Microsoft.WindowsAppSDK.InteractiveExperiences.1.8.260708001\metadata\10.0.18362.0\Microsoft.Foundation.winmd"><Private>false</Private></Reference>
  <Reference Include="$(RepoRoot)packages\Microsoft.WindowsAppSDK.InteractiveExperiences.1.8.260708001\metadata\10.0.18362.0\Microsoft.Graphics.winmd"><Private>false</Private></Reference>
  <Reference Include="$(RepoRoot)packages\Microsoft.WindowsAppSDK.InteractiveExperiences.1.8.260708001\metadata\10.0.18362.0\Microsoft.UI.winmd"><Private>false</Private></Reference>
  <Reference Include="$(RepoRoot)packages\Microsoft.WindowsAppSDK.ML.1.8.2197\metadata\Microsoft.Windows.AI.MachineLearning.winmd"><Private>false</Private></Reference>
  <Reference Include="$(RepoRoot)packages\Microsoft.WindowsAppSDK.Widgets.1.8.251231004\metadata\Microsoft.Windows.Widgets.winmd"><Private>false</Private></Reference>
  <Reference Include="$(RepoRoot)packages\Microsoft.WindowsAppSDK.WinUI.1.8.260803003\metadata\Microsoft.UI.Text.winmd"><Private>false</Private></Reference>
  <Reference Include="$(RepoRoot)packages\Microsoft.WindowsAppSDK.WinUI.1.8.260803003\metadata\Microsoft.UI.Xaml.winmd"><Private>false</Private></Reference>
  </ItemGroup>
  <ItemDefinitionGroup>
    <ClCompile><AdditionalIncludeDirectories>$(RepoRoot)packages\Microsoft.WindowsAppSDK.InteractiveExperiences.1.8.260708001\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories></ClCompile>
    <Link><AdditionalDependencies>$(RepoRoot)packages\Microsoft.WindowsAppSDK.InteractiveExperiences.1.8.260708001\lib\native\win10-x64\Microsoft.UI.Dispatching.lib;%(AdditionalDependencies)</AdditionalDependencies></Link>
  </ItemDefinitionGroup>
</Project>
