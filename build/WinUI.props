<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Windows App SDK / WinUI 3 wiring shared by WidgetManager.exe, WidgetHost.exe and
       any plugin that hosts a XAML island. Import AFTER Microsoft.Cpp.props.

       Self-contained and unpackaged: the runtime ships next to the executable and the
       WinRT classes are activated through the generated SxS manifest (RegFreeWinRT),
       so a widget host does not need a machine-wide Windows App SDK install.

       The explicit <Reference> items are not redundant: the package targets did not add
       the WinUI/InteractiveExperiences .winmd files to the C++/WinRT reference list in
       this project layout (verified by diffing the generated cppwinrt .rsp against the
       manager's), so they are declared here from the manager's working list. -->
  <PropertyGroup>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackage>false</AppxPackage>
    <UseWinUI>true</UseWinUI>
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTGenerateWindowsMetadata>false</CppWinRTGenerateWindowsMetadata>
  </PropertyGroup>
<Import Project="$(RepoRoot)packages\Microsoft.Windows.CppWinRT.2.0.250303.1\build\native\Microsoft.Windows.CppWinRT.props"/>
<Import Project="$(RepoRoot)packages\Microsoft.Windows.SDK.BuildTools.10.0.26100.4654\build\Microsoft.Windows.SDK.BuildTools.props"/>
<Import Project="$(RepoRoot)packages\Microsoft.Windows.SDK.BuildTools.MSIX.1.7.20250829.1\build\Microsoft.Windows.SDK.BuildTools.MSIX.props"/>
<Import Project="$(RepoRoot)packages\Microsoft.WindowsAppSDK.1.8.260804001\build\native\Microsoft.WindowsAppSDK.props"/>
<Import Project="$(RepoRoot)packages\Microsoft.WindowsAppSDK.AI.1.8.79\build\native\Microsoft.WindowsAppSDK.AI.props"/>
<Import Project="$(RepoRoot)packages\Microsoft.WindowsAppSDK.Base.1.8.251216001\build\native\Microsoft.WindowsAppSDK.Base.props"/>
<Import Project="$(RepoRoot)packages\Microsoft.WindowsAppSDK.DWrite.1.8.25122902\build\Microsoft.WindowsAppSDK.DWrite.props"/>
<Import Project="$(RepoRoot)packages\Microsoft.WindowsAppSDK.Foundation.1.8.260803002\build\Microsoft.WindowsAppSDK.Foundation.props"/>
<Import Project="$(RepoRoot)packages\Microsoft.WindowsAppSDK.InteractiveExperiences.1.8.260708001\build\Microsoft.WindowsAppSDK.InteractiveExperiences.props"/>
<Import Project="$(RepoRoot)packages\Microsoft.WindowsAppSDK.ML.1.8.2197\build\Microsoft.WindowsAppSDK.ML.props"/>
<Import Project="$(RepoRoot)packages\Microsoft.WindowsAppSDK.Runtime.1.8.260804001\build\Microsoft.WindowsAppSDK.Runtime.props"/>
<Import Project="$(RepoRoot)packages\Microsoft.WindowsAppSDK.Widgets.1.8.251231004\build\Microsoft.WindowsAppSDK.Widgets.props"/>
<Import Project="$(RepoRoot)packages\Microsoft.WindowsAppSDK.WinUI.1.8.260803003\build\Microsoft.WindowsAppSDK.WinUI.props"/>
  <ItemGroup>
  <Reference Include="$(RepoRoot)packages\Microsoft.Web.WebView2.1.0.3179.45\lib\Microsoft.Web.WebView2.Core.winmd"><Private>false</Private></Reference>
  <Reference Include="$(RepoRoot)packages\Microsoft.WindowsAppSDK.AI.1.8.79\metadata\Microsoft.Graphics.Imaging.winmd"><Private>false</Private></Reference>
  <Reference Include="$(RepoRoot)packages\Microsoft.WindowsAppSDK.AI.1.8.79\metadata\Microsoft.Windows.AI.ContentSafety.winmd"><Private>false</Private></Reference>
